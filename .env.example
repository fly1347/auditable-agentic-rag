# Public cloud runtime example.
#
# Model names, endpoints, execution profiles, prompt limits, ACL paths and
# egress policy belong in config.yaml (or a checked container overlay). This
# file supplies secrets and process-only toggles. Never commit a real .env.

# Trusted API principals. Replace all demonstration tokens before exposing the
# service beyond localhost. Roles/groups/tenant cannot be sent in request JSON.
AGENTIC_RAG_STATIC_PRINCIPALS_JSON='{"demo-public-token":{"principal_id":"demo-public","roles":["user","debug","public_egress"],"groups":[]},"demo-platform-token":{"principal_id":"alice","roles":["user","engineer","debug"],"groups":["platform"]},"demo-product-token":{"principal_id":"bob","roles":["user","analyst","debug","public_egress"],"groups":["product"]},"demo-admin-token":{"principal_id":"admin","roles":["user","admin"],"groups":["admin"]}}'

# Secrets used by the public default generator/judge profiles.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=auditable-agentic-rag

# Runtime identity and config selection.
AGENTIC_RAG_CONFIG=config.yaml
AGENTIC_RAG_CODE_REF=public-workspace

# Model-cache policy. Production and the supplied containers default offline;
# populate the mounted cache before starting them.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
DISABLE_EMBED_CACHE=false
EMBED_CACHE_MAX_SIZE=1000

# Process-level capacity.
MAX_GENERATION_CONCURRENCY=1
MAX_QUEUE_SIZE=10

# Existing deployment/budget telemetry hooks. Egress authorization itself is
# controlled by config.yaml and is rechecked per provider attempt.
AGENTIC_RAG_SECURITY_MODE=development
AGENTIC_RAG_AUDIT_LOG_ENABLED=true
AGENTIC_RAG_COST_BUDGET_USD=0.05
AGENTIC_RAG_MAX_LLM_CALLS=8
AGENTIC_RAG_MAX_TOTAL_TOKENS=12000
AGENTIC_RAG_ALLOW_CLOUD_GENERATOR=true
AGENTIC_RAG_ALLOW_LOCAL_FALLBACK=false

# UI process only. The user enters an API token in the UI; provider secrets are
# intentionally not passed to the UI container.
AGENTIC_RAG_API_BASE_URL=http://localhost:8000
AGENTIC_RAG_UI_TIMEOUT_SECONDS=300
