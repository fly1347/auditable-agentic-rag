# Public Docker cloud runtime example.
#
# Copy to docker/.env and replace every demonstration token before exposing
# the service beyond localhost. Model identities, endpoints, execution
# profiles, prompt limits and egress policy belong in typed YAML config.

# Trusted API principals. Roles/groups/tenant cannot be supplied in request
# JSON. public_egress is an explicit capability; admin alone does not grant it.
AGENTIC_RAG_STATIC_PRINCIPALS_JSON={"demo-public-token":{"principal_id":"demo-public","roles":["user","debug","public_egress"],"groups":[]},"demo-platform-token":{"principal_id":"demo-platform","roles":["engineer","debug"],"groups":["platform"]},"demo-admin-token":{"principal_id":"demo-admin","roles":["admin"],"groups":["admin"]}}

# Cloud providers used by the public Docker runtime.
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=auditable-agentic-rag
DEEPSEEK_API_KEY=

# Runtime identity and offline cache policy.
AGENTIC_RAG_CODE_REF=public-docker
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_CACHE_DIR=../.cache/huggingface
TORCH_CACHE_DIR=../.cache/torch
DISABLE_EMBED_CACHE=false

# Capacity/budget telemetry hooks. Egress authorization is controlled by typed
# YAML config and is rechecked before each provider attempt.
AGENTIC_RAG_SECURITY_MODE=development
AGENTIC_RAG_AUDIT_LOG_ENABLED=true
AGENTIC_RAG_COST_BUDGET_USD=0.05
AGENTIC_RAG_MAX_LLM_CALLS=8
AGENTIC_RAG_MAX_TOTAL_TOKENS=12000
AGENTIC_RAG_ALLOW_CLOUD_GENERATOR=true
AGENTIC_RAG_ALLOW_LOCAL_FALLBACK=false
MAX_GENERATION_CONCURRENCY=1
MAX_QUEUE_SIZE=10

# UI only. Provider secrets are intentionally not passed to the UI container.
AGENTIC_RAG_API_BASE_URL=http://api:8000
AGENTIC_RAG_UI_TIMEOUT_SECONDS=300
