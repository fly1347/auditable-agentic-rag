FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install --upgrade pip \
    && python -m pip install -e '.[ui]'

EXPOSE 8501

CMD ["streamlit", "run", "src/agentic_rag/ui/streamlit_app.py", "--server.address", "0.0.0.0", "--server.port", "8501"]
