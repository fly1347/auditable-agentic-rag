{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic RAG evaluation dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_class",
    "created_at",
    "author",
    "source_boundary",
    "contamination_check",
    "dataset_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_class": {
      "enum": [
        "derived_in_domain_regression",
        "held_out",
        "adversarial",
        "security_synthetic"
      ]
    },
    "created_at": {"type": "string", "minLength": 1},
    "author": {"type": "string", "minLength": 1},
    "source_boundary": {"type": "string", "minLength": 1},
    "contamination_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "result"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail", "not_run"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
